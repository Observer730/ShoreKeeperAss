<Window x:Class="AIAssistant.Host.Wpf.ReadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 听书"
        Height="700"
        Width="1000"
        MinHeight="560"
        MinWidth="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="RefreshButton" Width="88" Height="32" Click="RefreshButton_Click" Content="刷新" />
                <Button x:Name="OpenFileButton" Width="100" Height="32" Margin="8,0,0,0" Click="OpenFileButton_Click" Content="打开文件" />
            </StackPanel>
            <ListBox x:Name="BookList" SelectionChanged="BookList_SelectionChanged" />
        </DockPanel>

        <Grid x:Name="RightPanel" Grid.Row="0" Grid.Column="2" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="BookTitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="未打开书籍" />
            <ComboBox x:Name="ChapterComboBox" Grid.Row="1" Margin="0,12,0,0" Height="32" DisplayMemberPath="Title" SelectionChanged="ChapterComboBox_SelectionChanged" />
            <TextBox x:Name="SegmentTextBox" Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="16" />
            <Slider x:Name="SegmentSlider" Grid.Row="3" Margin="0,12,0,0" Minimum="0" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" PreviewMouseLeftButtonUp="SegmentSlider_PreviewMouseLeftButtonUp" />
            <TextBlock x:Name="TimeText" Grid.Row="4" Margin="0,8,0,0" Text="00:00 / 00:00" />
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="PlayButton" Width="88" Height="32" Click="PlayButton_Click" Content="播放" />
                <Button x:Name="PrevSegmentButton" Width="88" Height="32" Margin="8,0,0,0" Click="PrevSegmentButton_Click" Content="上一段" />
                <Button x:Name="NextSegmentButton" Width="88" Height="32" Margin="8,0,0,0" Click="NextSegmentButton_Click" Content="下一段" />
                <Button x:Name="PrevChapterButton" Width="88" Height="32" Margin="8,0,0,0" Click="PrevChapterButton_Click" Content="上一章" />
                <Button x:Name="NextChapterButton" Width="88" Height="32" Margin="8,0,0,0" Click="NextChapterButton_Click" Content="下一章" />
                <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Text="倍速" />
                <ComboBox x:Name="SpeedComboBox" Width="80" Height="32" SelectionChanged="SpeedComboBox_SelectionChanged" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#4B5563" Text="选择一本书开始。" />
    </Grid>
</Window>
